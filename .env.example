# Copy to .env and fill in. Never commit .env.
# Generate the session secret:
#   python -c 'import secrets; print(secrets.token_urlsafe(48))'
VITALS_SECRET_KEY=

# Argon2 hash of the dashboard password. Do not put the password here.
# Set it with: uv run python scripts/set_password.py
VITALS_PASSWORD_HASH=

# Two independent AvalAI accounts. The variable names are fixed; the labels
# shown on the cards are yours to choose.
AVALAI_PERSONAL_API_KEY=
AVALAI_COMPANY_API_KEY=
AVALAI_PERSONAL_LABEL=حساب اول
AVALAI_COMPANY_LABEL=حساب دوم

# Provider endpoint. Leave as is unless AvalAI changes it.
AVALAI_CREDIT_ENDPOINT=https://api.avalai.ir/user/v1/credit

# Link behind the dashboard's "buy packages" button. The default opens the
# AvalAI marketplace filtered to the Coder packages.
AVALAI_PACKAGES_URL=https://chat.avalai.ir/platform/billing/packages?marketplace&q=%DA%A9%D8%AF%D8%B1&sort=price

# The filesystem whose free space the dashboard shows, and the free-space
# threshold below which the card warns. Keep the threshold in step with the
# Bale bot's CRIER_DISK_THRESHOLD_GIB so the card and the alerts agree.
VITALS_DISK_PATH=/
VITALS_DISK_THRESHOLD_GIB=2

# Only these Host values are accepted. Add the public host or IP you use.
VITALS_ALLOWED_HOSTS=vitals.example.com,localhost,127.0.0.1

# Keep true in production: sessions only travel over HTTPS.
VITALS_COOKIE_SECURE=true

# The session slides with activity: it ends after this many hours without a
# request, and never lasts longer than VITALS_SESSION_MAX_HOURS after login.
VITALS_SESSION_IDLE_HOURS=168
VITALS_SESSION_MAX_HOURS=720

# Provider cache and how long a failed fetch is remembered before retrying.
VITALS_CACHE_TTL=60
VITALS_RETRY_AFTER=120
VITALS_HTTP_TIMEOUT=12
